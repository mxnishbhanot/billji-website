# Production origin used for metadataBase, canonical, Open Graph, robots.txt
# and sitemap.xml. Defaults to https://billji.app when unset.
NEXT_PUBLIC_SITE_URL=https://billji.app

# BillJi application origin. Used by the "Sign in" link.
# The link is NOT rendered while this is empty.
NEXT_PUBLIC_APP_URL=

# Sign-up / get-started destination for every "Get BillJi Free" and pricing
# plan button. Falls back to NEXT_PUBLIC_APP_URL, then to the on-page
# #pricing section.
NEXT_PUBLIC_SIGNUP_URL=

# App-store listings. No store-badge UI exists on the site yet, so these are
# not read by any component — add them here once the listings and the UI to
# link them both exist.
# NEXT_PUBLIC_PLAY_STORE_URL=
# NEXT_PUBLIC_APP_STORE_URL=
